# Copy to .env (docker compose reads it automatically) and fill in.
# Don't commit or share .env: it holds secrets.

# --- SAS Viya -----------------------------------------------------------------
VIYA_HOSTNAME=viya.example.com
# Optional, comma-separated; default: openid,sas-compute.user_impersonation
#VIYA_SCOPES=

# Workbench SAS Logon client (leave all Workbench values empty to disable).
# Register redirect URI: http://localhost:8787/oauth_redirect_callback
WORKBENCH_VIYA_CLIENT_ID=posit-workbench
WORKBENCH_VIYA_CLIENT_SECRET=

# Default connection profile for the Positron SAS extension (endpoint is
# https://VIYA_HOSTNAME); written only when VIYA_HOSTNAME is set. The client is
# what the extension uses when it signs in with SAS Logon itself.
POSITRON_SAS_CLIENT_ID=vscode-positron
#POSITRON_SAS_CLIENT_SECRET=

# Connect SAS Logon client, a separate client from Workbench's.
# Register redirect URI: http://localhost:3939/__oauth__/integrations/callback
CONNECT_VIYA_CLIENT_ID=posit-connect
CONNECT_VIYA_CLIENT_SECRET=

# --- User posit ----------------------------------------------------------------
# Password of the user posit in Workbench and Connect (Connect role: publisher).
# Connect rejects weak passwords. Applies when the user is created: Workbench
# on container re-creation, Connect only on first creation.
#POSIT_USER_PASSWORD=positsas2026

# --- Connect admin --------------------------------------------------------------
# Created by connect-init on first start. If the password is empty, a random
# one is generated: docker compose exec connect cat /var/lib/connect-bootstrap/admin-password
#CONNECT_ADMIN_USER=admin
#CONNECT_ADMIN_PASSWORD=
# Only needed if Connect already had users before connect-init first ran.
#CONNECT_INIT_API_KEY=
